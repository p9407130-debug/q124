#include <stdio.h>
#include <ctype.h>
int main() {
    char str[100];
    int i = 0;
    int capitalize_next = 1;
    printf("Enter a string: ");
    fgets(str, sizeof(str), stdin);
    while (str[i] != '\0') {
        if (capitalize_next && isalpha(str[i])) {
            str[i] = toupper(str[i]);
            capitalize_next = 0; 
        } else {
            str[i] = tolower(str[i]);
        }
        if (str[i] == '.') {
            capitalize_next = 1;
        }
        i++;
    }
    printf("Sentence case: %s", str);
    return 0;
}
